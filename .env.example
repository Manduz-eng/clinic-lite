
# Clinic-Lite HMIS Environment Variables

# ---------- Backend (API) ----------
# Supabase Database Connection (use Session Pooler for DATABASE_URL, Direct for DIRECT_URL)
DATABASE_URL=
DIRECT_URL=

# JWT Secrets
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server Config
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# ---------- Frontend (Web) ----------
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

