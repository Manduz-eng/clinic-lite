generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Multi-Tenancy ──────────────────────────────────────────────

model Tenant {
  id                  String   @id @default(uuid())
  name                String
  slug                String   @unique
  logoUrl             String?  @map("logo_url")
  address             String?
  phone               String?
  email               String?
  licenseNo           String?  @map("license_no")
  mpesaShortcode      String?  @map("mpesa_shortcode")
  mpesaPasskey        String?  @map("mpesa_passkey")
  mpesaConsumerKey    String?  @map("mpesa_consumer_key")
  mpesaConsumerSecret String?  @map("mpesa_consumer_secret")
  settings            Json?
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  users              User[]
  roles              Role[]
  patients           Patient[]
  visits             Visit[]
  vitals             Vitals[]
  nursingNotes       NursingNote[]
  clinicalNotes      ClinicalNote[]
  diagnoses          Diagnosis[]
  prescriptions      Prescription[]
  labTestCatalog     LabTestCatalog[]
  labRequests        LabRequest[]
  labResults         LabResult[]
  drugs              Drug[]
  drugStock          DrugStock[]
  dispensing         Dispensing[]
  invoices           Invoice[]
  payments           Payment[]
  mpesaTransactions  MpesaTransaction[]
  suppliers          Supplier[]
  purchaseOrders     PurchaseOrder[]
  goodsReceivedNotes GoodsReceivedNote[]
  stockAlerts        StockAlert[]
  expenseCategories  ExpenseCategory[]
  expenses           Expense[]
  ledgerEntries      LedgerEntry[]
  auditLogs          AuditLog[]
  notifications      Notification[]

  @@map("tenants")
}

// ─── Auth & RBAC ────────────────────────────────────────────────

model Role {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  users       User[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@map("roles")
}

model Permission {
  id          String @id @default(uuid())
  module      String
  action      String
  description String?

  roles RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  roleId       String    @map("role_id")
  email        String
  passwordHash String    @map("password_hash")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  phone        String?
  employeeNo   String?   @map("employee_no")
  isActive     Boolean   @default(true) @map("is_active")
  lastLogin    DateTime? @map("last_login")
  refreshToken String?   @map("refresh_token")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  registeredVisits  Visit[]        @relation("RegisteredBy")
  assignedVisits    Visit[]        @relation("AssignedDoctor")
  vitalsRecorded    Vitals[]       @relation("VitalsRecordedBy")
  nursingNotes      NursingNote[]
  clinicalNotes     ClinicalNote[]
  prescriptions     Prescription[]
  labRequested      LabRequest[]   @relation("LabRequestedBy")
  labPerformed      LabResult[]    @relation("LabPerformedBy")
  labVerified       LabResult[]    @relation("LabVerifiedBy")
  dispensedBy       Dispensing[]
  invoicesGenerated Invoice[]
  paymentsReceived  Payment[]
  posRequested      PurchaseOrder[] @relation("PORequestedBy")
  posApproved       PurchaseOrder[] @relation("POApprovedBy")
  grnsReceived      GoodsReceivedNote[]
  expensesRecorded  Expense[]      @relation("ExpenseRecordedBy")
  expensesApproved  Expense[]      @relation("ExpenseApprovedBy")
  ledgerEntries     LedgerEntry[]
  auditLogs         AuditLog[]

  @@unique([tenantId, email])
  @@map("users")
}

// ─── Reception ──────────────────────────────────────────────────

enum Gender {
  male
  female
  other
}

model Patient {
  id                    String   @id @default(uuid())
  tenantId              String   @map("tenant_id")
  patientNo             String   @map("patient_no")
  firstName             String   @map("first_name")
  lastName              String   @map("last_name")
  dateOfBirth           DateTime @map("date_of_birth") @db.Date
  gender                Gender
  nationalId            String?  @map("national_id")
  phone                 String?
  email                 String?
  address               String?
  emergencyContactName  String?  @map("emergency_contact_name")
  emergencyContactPhone String?  @map("emergency_contact_phone")
  bloodGroup            String?  @map("blood_group")
  allergies             String?
  insuranceProvider     String?  @map("insurance_provider")
  insuranceNo           String?  @map("insurance_no")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  visits   Visit[]
  invoices Invoice[]

  @@unique([tenantId, patientNo])
  @@map("patients")
}

enum VisitType {
  new_visit
  follow_up
  emergency
}

enum VisitStatus {
  queued
  in_triage
  in_nursing
  with_doctor
  in_lab
  at_pharmacy
  billing
  completed
  cancelled
}

enum Priority {
  normal
  urgent
  emergency
}

model Visit {
  id              String      @id @default(uuid())
  tenantId        String      @map("tenant_id")
  patientId       String      @map("patient_id")
  visitNo         String      @map("visit_no")
  visitDate       DateTime    @map("visit_date") @db.Date
  visitType       VisitType   @default(new_visit) @map("visit_type")
  status          VisitStatus @default(queued)
  queueNumber     Int         @map("queue_number")
  priority        Priority    @default(normal)
  chiefComplaint  String?     @map("chief_complaint")
  registeredById  String      @map("registered_by")
  assignedDoctorId String?    @map("assigned_doctor")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  patient        Patient       @relation(fields: [patientId], references: [id])
  registeredBy   User          @relation("RegisteredBy", fields: [registeredById], references: [id])
  assignedDoctor User?         @relation("AssignedDoctor", fields: [assignedDoctorId], references: [id])
  vitals         Vitals?
  nursingNotes   NursingNote[]
  clinicalNote   ClinicalNote?
  diagnoses      Diagnosis[]
  prescriptions  Prescription[]
  labRequests    LabRequest[]
  dispensing     Dispensing[]
  invoices       Invoice[]

  @@index([tenantId, visitDate, status])
  @@map("visits")
}

// ─── Triage ─────────────────────────────────────────────────────

model Vitals {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  visitId          String   @unique @map("visit_id")
  systolicBp       Int?     @map("systolic_bp")
  diastolicBp      Int?     @map("diastolic_bp")
  heartRate        Int?     @map("heart_rate")
  temperature      Decimal? @db.Decimal(4, 1)
  weight           Decimal? @db.Decimal(5, 1)
  height           Decimal? @db.Decimal(5, 1)
  bmi              Decimal? @db.Decimal(4, 1)
  respiratoryRate  Int?     @map("respiratory_rate")
  oxygenSaturation Decimal? @map("oxygen_saturation") @db.Decimal(4, 1)
  notes            String?
  recordedById     String   @map("recorded_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  visit      Visit  @relation(fields: [visitId], references: [id])
  recordedBy User   @relation("VitalsRecordedBy", fields: [recordedById], references: [id])

  @@map("vitals")
}

// ─── Nursing Station ────────────────────────────────────────────

enum NoteType {
  assessment
  treatment
  observation
  handover
}

model NursingNote {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  visitId       String   @map("visit_id")
  noteType      NoteType @map("note_type")
  content       String
  treatmentRoom String?  @map("treatment_room")
  recordedById  String   @map("recorded_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  visit      Visit  @relation(fields: [visitId], references: [id])
  recordedBy User   @relation(fields: [recordedById], references: [id])

  @@map("nursing_notes")
}

// ─── OPD (Doctor's Desk) ───────────────────────────────────────

model ClinicalNote {
  id                  String   @id @default(uuid())
  tenantId            String   @map("tenant_id")
  visitId             String   @unique @map("visit_id")
  historyOfIllness    String?  @map("history_of_illness")
  examinationFindings String?  @map("examination_findings")
  assessment          String?
  plan                String?
  followUpDate        DateTime? @map("follow_up_date") @db.Date
  doctorId            String   @map("doctor_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  visit     Visit       @relation(fields: [visitId], references: [id])
  doctor    User        @relation(fields: [doctorId], references: [id])
  diagnoses Diagnosis[]

  @@map("clinical_notes")
}

enum DiagnosisType {
  primary
  secondary
  differential
}

model Diagnosis {
  id             String        @id @default(uuid())
  tenantId       String        @map("tenant_id")
  visitId        String        @map("visit_id")
  clinicalNoteId String        @map("clinical_note_id")
  icdCode        String        @map("icd_code")
  description    String
  diagnosisType  DiagnosisType @map("diagnosis_type")
  createdAt      DateTime      @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  visit        Visit        @relation(fields: [visitId], references: [id])
  clinicalNote ClinicalNote @relation(fields: [clinicalNoteId], references: [id])

  @@index([tenantId, icdCode])
  @@map("diagnoses")
}

enum PrescriptionStatus {
  pending
  dispensed
  partially_dispensed
  cancelled
}

model Prescription {
  id        String             @id @default(uuid())
  tenantId  String             @map("tenant_id")
  visitId   String             @map("visit_id")
  doctorId  String             @map("doctor_id")
  notes     String?
  status    PrescriptionStatus @default(pending)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  visit      Visit              @relation(fields: [visitId], references: [id])
  doctor     User               @relation(fields: [doctorId], references: [id])
  items      PrescriptionItem[]
  dispensing Dispensing[]

  @@map("prescriptions")
}

model PrescriptionItem {
  id             String   @id @default(uuid())
  prescriptionId String   @map("prescription_id")
  drugId         String   @map("drug_id")
  dosage         String
  frequency      String
  duration       String
  quantity       Int
  route          String?
  instructions   String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  prescription   Prescription    @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  drug           Drug            @relation(fields: [drugId], references: [id])
  dispensingItems DispensingItem[]

  @@map("prescription_items")
}

// ─── Laboratory ─────────────────────────────────────────────────

model LabTestCatalog {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  name           String
  code           String
  category       String?
  price          Decimal  @db.Decimal(10, 2)
  turnaroundTime String?  @map("turnaround_time")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  labRequests LabRequest[]

  @@unique([tenantId, code])
  @@map("lab_test_catalog")
}

enum LabPriority {
  normal
  urgent
  stat
}

enum LabRequestStatus {
  requested
  sample_collected
  processing
  completed
  cancelled
}

model LabRequest {
  id            String           @id @default(uuid())
  tenantId      String           @map("tenant_id")
  visitId       String           @map("visit_id")
  testId        String           @map("test_id")
  requestedById String           @map("requested_by")
  priority      LabPriority      @default(normal)
  clinicalInfo  String?          @map("clinical_info")
  status        LabRequestStatus @default(requested)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  visit       Visit          @relation(fields: [visitId], references: [id])
  test        LabTestCatalog @relation(fields: [testId], references: [id])
  requestedBy User           @relation("LabRequestedBy", fields: [requestedById], references: [id])
  result      LabResult?

  @@map("lab_requests")
}

model LabResult {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  labRequestId   String   @unique @map("lab_request_id")
  resultValue    String   @map("result_value")
  unit           String?
  referenceRange String?  @map("reference_range")
  isAbnormal     Boolean  @default(false) @map("is_abnormal")
  notes          String?
  performedById  String   @map("performed_by")
  verifiedById   String?  @map("verified_by")
  resultDate     DateTime @map("result_date")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  labRequest  LabRequest @relation(fields: [labRequestId], references: [id])
  performedBy User       @relation("LabPerformedBy", fields: [performedById], references: [id])
  verifiedBy  User?      @relation("LabVerifiedBy", fields: [verifiedById], references: [id])

  @@map("lab_results")
}

// ─── Pharmacy & Inventory ───────────────────────────────────────

model Drug {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  name         String
  brandName    String?  @map("brand_name")
  code         String
  category     String?
  form         String?
  strength     String?
  unit         String?
  unitPrice    Decimal  @map("unit_price") @db.Decimal(10, 2)
  reorderLevel Int      @default(10) @map("reorder_level")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  stock             DrugStock[]
  prescriptionItems PrescriptionItem[]
  stockAlerts       StockAlert[]
  purchaseOrderItems PurchaseOrderItem[]
  grnItems          GrnItem[]

  @@unique([tenantId, code])
  @@map("drugs")
}

model DrugStock {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  drugId       String    @map("drug_id")
  batchNumber  String    @map("batch_number")
  quantity     Int
  costPrice    Decimal   @map("cost_price") @db.Decimal(10, 2)
  expiryDate   DateTime  @map("expiry_date") @db.Date
  receivedDate DateTime  @map("received_date") @db.Date
  grnId        String?   @map("grn_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant          Tenant             @relation(fields: [tenantId], references: [id])
  drug            Drug               @relation(fields: [drugId], references: [id])
  grn             GoodsReceivedNote? @relation(fields: [grnId], references: [id])
  dispensingItems DispensingItem[]

  @@index([tenantId, drugId, expiryDate])
  @@map("drug_stock")
}

enum DispensingStatus {
  pending
  dispensed
  partial
  returned
}

model Dispensing {
  id             String           @id @default(uuid())
  tenantId       String           @map("tenant_id")
  prescriptionId String           @map("prescription_id")
  visitId        String           @map("visit_id")
  dispensedById  String           @map("dispensed_by")
  status         DispensingStatus @default(pending)
  notes          String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  prescription Prescription     @relation(fields: [prescriptionId], references: [id])
  visit        Visit            @relation(fields: [visitId], references: [id])
  dispensedBy  User             @relation(fields: [dispensedById], references: [id])
  items        DispensingItem[]

  @@map("dispensing")
}

model DispensingItem {
  id                 String   @id @default(uuid())
  dispensingId       String   @map("dispensing_id")
  prescriptionItemId String   @map("prescription_item_id")
  drugStockId        String   @map("drug_stock_id")
  quantity           Int
  createdAt          DateTime @default(now()) @map("created_at")

  dispensing       Dispensing       @relation(fields: [dispensingId], references: [id], onDelete: Cascade)
  prescriptionItem PrescriptionItem @relation(fields: [prescriptionItemId], references: [id])
  drugStock        DrugStock        @relation(fields: [drugStockId], references: [id])

  @@map("dispensing_items")
}

// ─── Billing & Payments ─────────────────────────────────────────

enum InvoiceStatus {
  draft
  pending
  partially_paid
  paid
  cancelled
  refunded
}

model Invoice {
  id            String        @id @default(uuid())
  tenantId      String        @map("tenant_id")
  visitId       String        @map("visit_id")
  patientId     String        @map("patient_id")
  invoiceNo     String        @map("invoice_no")
  subtotal      Decimal       @db.Decimal(12, 2)
  taxAmount     Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(12, 2)
  paidAmount    Decimal       @default(0) @map("paid_amount") @db.Decimal(12, 2)
  balance       Decimal       @db.Decimal(12, 2)
  status        InvoiceStatus @default(draft)
  dueDate       DateTime?     @map("due_date") @db.Date
  generatedById String        @map("generated_by")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  visit       Visit         @relation(fields: [visitId], references: [id])
  patient     Patient       @relation(fields: [patientId], references: [id])
  generatedBy User          @relation(fields: [generatedById], references: [id])
  items       InvoiceItem[]
  payments    Payment[]

  @@unique([tenantId, invoiceNo])
  @@map("invoices")
}

enum InvoiceItemType {
  consultation
  lab_test
  drug
  procedure
  other
}

model InvoiceItem {
  id          String          @id @default(uuid())
  invoiceId   String          @map("invoice_id")
  itemType    InvoiceItemType @map("item_type")
  referenceId String?         @map("reference_id")
  description String
  quantity    Int
  unitPrice   Decimal         @map("unit_price") @db.Decimal(10, 2)
  totalPrice  Decimal         @map("total_price") @db.Decimal(10, 2)
  createdAt   DateTime        @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

enum PaymentMethod {
  cash
  mpesa
  card
  insurance
  bank_transfer
}

model Payment {
  id            String        @id @default(uuid())
  tenantId      String        @map("tenant_id")
  invoiceId     String        @map("invoice_id")
  paymentMethod PaymentMethod @map("payment_method")
  amount        Decimal       @db.Decimal(12, 2)
  referenceNo   String?       @map("reference_no")
  paymentDate   DateTime      @map("payment_date")
  receivedById  String        @map("received_by")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  invoice          Invoice           @relation(fields: [invoiceId], references: [id])
  receivedBy       User              @relation(fields: [receivedById], references: [id])
  mpesaTransaction MpesaTransaction?

  @@map("payments")
}

enum MpesaStatus {
  initiated
  pending
  completed
  failed
  cancelled
}

model MpesaTransaction {
  id                 String      @id @default(uuid())
  tenantId           String      @map("tenant_id")
  paymentId          String?     @unique @map("payment_id")
  merchantRequestId  String      @map("merchant_request_id")
  checkoutRequestId  String      @map("checkout_request_id")
  phoneNumber        String      @map("phone_number")
  amount             Decimal     @db.Decimal(12, 2)
  mpesaReceipt       String?     @map("mpesa_receipt")
  resultCode         Int?        @map("result_code")
  resultDesc         String?     @map("result_desc")
  status             MpesaStatus @default(initiated)
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([checkoutRequestId])
  @@map("mpesa_transactions")
}

// ─── Procurement ────────────────────────────────────────────────

model Supplier {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  name          String
  contactPerson String?  @map("contact_person")
  email         String?
  phone         String?
  address       String?
  taxPin        String?  @map("tax_pin")
  paymentTerms  String?  @map("payment_terms")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  purchaseOrders     PurchaseOrder[]
  goodsReceivedNotes GoodsReceivedNote[]

  @@unique([tenantId, name])
  @@map("suppliers")
}

enum POStatus {
  draft
  submitted
  approved
  partially_received
  received
  cancelled
}

model PurchaseOrder {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  poNumber      String   @map("po_number")
  supplierId    String   @map("supplier_id")
  status        POStatus @default(draft)
  totalAmount   Decimal  @map("total_amount") @db.Decimal(12, 2)
  notes         String?
  requestedById String   @map("requested_by")
  approvedById  String?  @map("approved_by")
  orderDate     DateTime @map("order_date") @db.Date
  expectedDate  DateTime? @map("expected_date") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  supplier           Supplier            @relation(fields: [supplierId], references: [id])
  requestedBy        User                @relation("PORequestedBy", fields: [requestedById], references: [id])
  approvedBy         User?               @relation("POApprovedBy", fields: [approvedById], references: [id])
  items              PurchaseOrderItem[]
  goodsReceivedNotes GoodsReceivedNote[]

  @@unique([tenantId, poNumber])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String   @id @default(uuid())
  purchaseOrderId String   @map("purchase_order_id")
  drugId          String   @map("drug_id")
  quantity        Int
  unitCost        Decimal  @map("unit_cost") @db.Decimal(10, 2)
  totalCost       Decimal  @map("total_cost") @db.Decimal(10, 2)
  receivedQty     Int      @default(0) @map("received_qty")
  createdAt       DateTime @default(now()) @map("created_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  drug          Drug          @relation(fields: [drugId], references: [id])
  grnItems      GrnItem[]

  @@map("purchase_order_items")
}

model GoodsReceivedNote {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  grnNumber       String   @map("grn_number")
  purchaseOrderId String   @map("purchase_order_id")
  supplierId      String   @map("supplier_id")
  receivedById    String   @map("received_by")
  receivedDate    DateTime @map("received_date") @db.Date
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  purchaseOrder PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id])
  supplier      Supplier          @relation(fields: [supplierId], references: [id])
  receivedBy    User              @relation(fields: [receivedById], references: [id])
  items         GrnItem[]
  drugStock     DrugStock[]

  @@unique([tenantId, grnNumber])
  @@map("goods_received_notes")
}

model GrnItem {
  id         String   @id @default(uuid())
  grnId      String   @map("grn_id")
  poItemId   String   @map("po_item_id")
  drugId     String   @map("drug_id")
  quantity   Int
  batchNumber String  @map("batch_number")
  expiryDate DateTime @map("expiry_date") @db.Date
  costPrice  Decimal  @map("cost_price") @db.Decimal(10, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  grn    GoodsReceivedNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
  poItem PurchaseOrderItem @relation(fields: [poItemId], references: [id])
  drug   Drug              @relation(fields: [drugId], references: [id])

  @@map("grn_items")
}

enum AlertType {
  low_stock
  out_of_stock
  expiring
  expired
}

model StockAlert {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  drugId       String    @map("drug_id")
  alertType    AlertType @map("alert_type")
  currentStock Int       @map("current_stock")
  reorderLevel Int       @map("reorder_level")
  isResolved   Boolean   @default(false) @map("is_resolved")
  resolvedAt   DateTime? @map("resolved_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  drug   Drug   @relation(fields: [drugId], references: [id])

  @@index([tenantId, isResolved])
  @@map("stock_alerts")
}

// ─── Accounts ───────────────────────────────────────────────────

model ExpenseCategory {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  expenses Expense[]

  @@unique([tenantId, name])
  @@map("expense_categories")
}

enum ExpenseStatus {
  pending
  approved
  rejected
}

enum ExpensePaymentMethod {
  cash
  mpesa
  bank_transfer
  cheque
}

model Expense {
  id            String               @id @default(uuid())
  tenantId      String               @map("tenant_id")
  categoryId    String               @map("category_id")
  amount        Decimal              @db.Decimal(12, 2)
  description   String
  referenceNo   String?              @map("reference_no")
  expenseDate   DateTime             @map("expense_date") @db.Date
  paymentMethod ExpensePaymentMethod @map("payment_method")
  receiptUrl    String?              @map("receipt_url")
  recordedById  String               @map("recorded_by")
  approvedById  String?              @map("approved_by")
  status        ExpenseStatus        @default(pending)
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  category   ExpenseCategory @relation(fields: [categoryId], references: [id])
  recordedBy User            @relation("ExpenseRecordedBy", fields: [recordedById], references: [id])
  approvedBy User?           @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])

  @@index([tenantId, expenseDate])
  @@map("expenses")
}

enum EntryType {
  revenue
  expense
  adjustment
}

model LedgerEntry {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  entryDate     DateTime  @map("entry_date") @db.Date
  entryType     EntryType @map("entry_type")
  category      String
  description   String
  debit         Decimal   @default(0) @db.Decimal(12, 2)
  credit        Decimal   @default(0) @db.Decimal(12, 2)
  balance       Decimal   @db.Decimal(12, 2)
  referenceType String?   @map("reference_type")
  referenceId   String?   @map("reference_id")
  recordedById  String    @map("recorded_by")
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  recordedBy User   @relation(fields: [recordedById], references: [id])

  @@index([tenantId, entryDate, entryType])
  @@map("ledger_entries")
}

// ─── Audit & Notifications ─────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  userId     String   @map("user_id")
  action     String
  module     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, module, createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String?  @map("user_id")
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false) @map("is_read")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, userId, isRead])
  @@map("notifications")
}
