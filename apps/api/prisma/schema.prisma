generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Multi-Tenancy ──────────────────────────────────────────────

model Tenant {
  id                  String   @id @default(uuid())
  name                String
  slug                String   @unique
  logoUrl             String?  @map("logo_url")
  address             String?
  phone               String?
  email               String?
  licenseNo           String?  @map("license_no")
  mpesaShortcode      String?  @map("mpesa_shortcode")
  mpesaPasskey        String?  @map("mpesa_passkey")
  mpesaConsumerKey    String?  @map("mpesa_consumer_key")
  mpesaConsumerSecret String?  @map("mpesa_consumer_secret")
  settings            String?
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  users              User[]
  roles              Role[]
  patients           Patient[]
  visits             Visit[]
  vitals             Vitals[]
  nursingNotes       NursingNote[]
  clinicalNotes      ClinicalNote[]
  diagnoses          Diagnosis[]
  prescriptions      Prescription[]
  labTestCatalog     LabTestCatalog[]
  labRequests        LabRequest[]
  labResults         LabResult[]
  drugs              Drug[]
  drugStock          DrugStock[]
  dispensing         Dispensing[]
  invoices           Invoice[]
  payments           Payment[]
  mpesaTransactions  MpesaTransaction[]
  suppliers          Supplier[]
  purchaseOrders     PurchaseOrder[]
  goodsReceivedNotes GoodsReceivedNote[]
  stockAlerts        StockAlert[]
  expenseCategories  ExpenseCategory[]
  expenses           Expense[]
  ledgerEntries      LedgerEntry[]
  auditLogs          AuditLog[]
  notifications      Notification[]

  @@map("tenants")
}

// ─── Auth & RBAC ────────────────────────────────────────────────

model Role {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  users       User[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@map("roles")
}

model Permission {
  id          String @id @default(uuid())
  module      String
  action      String
  description String?

  roles RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  roleId       String    @map("role_id")
  email        String
  passwordHash String    @map("password_hash")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  phone        String?
  employeeNo   String?   @map("employee_no")
  isActive     Boolean   @default(true) @map("is_active")
  lastLogin    DateTime? @map("last_login")
  refreshToken String?   @map("refresh_token")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  registeredVisits  Visit[]        @relation("RegisteredBy")
  assignedVisits    Visit[]        @relation("AssignedDoctor")
  vitalsRecorded    Vitals[]       @relation("VitalsRecordedBy")
  nursingNotes      NursingNote[]
  clinicalNotes     ClinicalNote[]
  prescriptions     Prescription[]
  labRequested      LabRequest[]   @relation("LabRequestedBy")
  labPerformed      LabResult[]    @relation("LabPerformedBy")
  labVerified       LabResult[]    @relation("LabVerifiedBy")
  dispensedBy       Dispensing[]
  invoicesGenerated Invoice[]
  paymentsReceived  Payment[]
  posRequested      PurchaseOrder[] @relation("PORequestedBy")
  posApproved       PurchaseOrder[] @relation("POApprovedBy")
  grnsReceived      GoodsReceivedNote[]
  expensesRecorded  Expense[]      @relation("ExpenseRecordedBy")
  expensesApproved  Expense[]      @relation("ExpenseApprovedBy")
  ledgerEntries     LedgerEntry[]
  auditLogs         AuditLog[]

  @@unique([tenantId, email])
  @@map("users")
}

// ─── Reception ──────────────────────────────────────────────────



model Patient {
  id                    String   @id @default(uuid())
  tenantId              String   @map("tenant_id")
  patientNo             String   @map("patient_no")
  firstName             String   @map("first_name") // Map to "Other Names"
  lastName              String   @map("last_name")  // Map to "Surname"
  dateOfBirth           DateTime @map("date_of_birth") 
  gender                String
  idType                String?  @map("id_type")
  idNumber              String?  @map("id_number")
  phone                 String?
  phone2                String?  @map("phone_2")
  email                 String?
  address               String?  // Physical residence
  occupation            String?
  town                  String?
  nationality           String?  @default("Kenyan")
  nextOfKin             String?  @map("next_of_kin")
  relationship          String?
  nokPhone              String?  @map("nok_phone")
  postalAddress         String?  @map("postal_address")
  postalCode            String?  @map("postal_code")
  insuranceProvider     String?  @map("insurance_provider")
  insuranceNo           String?  @map("insurance_no")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  visits   Visit[]
  invoices Invoice[]

  @@unique([tenantId, patientNo])
  @@map("patients")
}







model Visit {
  id              String      @id @default(uuid())
  tenantId        String      @map("tenant_id")
  patientId       String      @map("patient_id")
  visitNo         String      @map("visit_no")
  visitDate       DateTime    @map("visit_date") 
  visitType       String   @default("new_visit") @map("visit_type")
  status          String @default("queued")
  queueNumber     Int         @map("queue_number")
  priority        String    @default("normal")
  chiefComplaint  String?     @map("chief_complaint")
  registeredById  String      @map("registered_by")
  assignedDoctorId String?    @map("assigned_doctor")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  patient        Patient       @relation(fields: [patientId], references: [id])
  registeredBy   User          @relation("RegisteredBy", fields: [registeredById], references: [id])
  assignedDoctor User?         @relation("AssignedDoctor", fields: [assignedDoctorId], references: [id])
  vitals         Vitals?
  nursingNotes   NursingNote[]
  clinicalNote   ClinicalNote?
  diagnoses      Diagnosis[]
  prescriptions  Prescription[]
  labRequests    LabRequest[]
  dispensing     Dispensing[]
  invoices       Invoice[]

  @@index([tenantId, visitDate, status])
  @@map("visits")
}

// ─── Triage ─────────────────────────────────────────────────────

model Vitals {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  visitId          String   @unique @map("visit_id")
  systolicBp       Int?     @map("systolic_bp")
  diastolicBp      Int?     @map("diastolic_bp")
  heartRate        Int?     @map("heart_rate")
  temperature      Float? 
  weight           Float? 
  height           Float? 
  bmi              Float? 
  respiratoryRate  Int?     @map("respiratory_rate")
  oxygenSaturation Float? @map("oxygen_saturation") 
  notes            String?
  recordedById     String   @map("recorded_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  visit      Visit  @relation(fields: [visitId], references: [id])
  recordedBy User   @relation("VitalsRecordedBy", fields: [recordedById], references: [id])

  @@map("vitals")
}

// ─── Nursing Station ────────────────────────────────────────────



model NursingNote {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  visitId       String   @map("visit_id")
  noteType      String @map("note_type")
  content       String
  treatmentRoom String?  @map("treatment_room")
  recordedById  String   @map("recorded_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  visit      Visit  @relation(fields: [visitId], references: [id])
  recordedBy User   @relation(fields: [recordedById], references: [id])

  @@map("nursing_notes")
}

// ─── OPD (Doctor's Desk) ───────────────────────────────────────

model ClinicalNote {
  id                  String   @id @default(uuid())
  tenantId            String   @map("tenant_id")
  visitId             String   @unique @map("visit_id")
  historyOfIllness    String?  @map("history_of_illness")
  examinationFindings String?  @map("examination_findings")
  assessment          String?
  plan                String?
  followUpDate        DateTime? @map("follow_up_date") 
  doctorId            String   @map("doctor_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  visit     Visit       @relation(fields: [visitId], references: [id])
  doctor    User        @relation(fields: [doctorId], references: [id])
  diagnoses Diagnosis[]

  @@map("clinical_notes")
}



model Diagnosis {
  id             String        @id @default(uuid())
  tenantId       String        @map("tenant_id")
  visitId        String        @map("visit_id")
  clinicalNoteId String        @map("clinical_note_id")
  icdCode        String        @map("icd_code")
  description    String
  diagnosisType  String @map("diagnosis_type")
  createdAt      DateTime      @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  visit        Visit        @relation(fields: [visitId], references: [id])
  clinicalNote ClinicalNote @relation(fields: [clinicalNoteId], references: [id])

  @@index([tenantId, icdCode])
  @@map("diagnoses")
}



model Prescription {
  id        String             @id @default(uuid())
  tenantId  String             @map("tenant_id")
  visitId   String             @map("visit_id")
  doctorId  String             @map("doctor_id")
  notes     String?
  status    String @default("pending")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  visit      Visit              @relation(fields: [visitId], references: [id])
  doctor     User               @relation(fields: [doctorId], references: [id])
  items      PrescriptionItem[]
  dispensing Dispensing[]

  @@map("prescriptions")
}

model PrescriptionItem {
  id             String   @id @default(uuid())
  prescriptionId String   @map("prescription_id")
  drugId         String   @map("drug_id")
  dosage         String
  frequency      String
  duration       String
  quantity       Int
  route          String?
  instructions   String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  prescription   Prescription    @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  drug           Drug            @relation(fields: [drugId], references: [id])
  dispensingItems DispensingItem[]

  @@map("prescription_items")
}

// ─── Laboratory ─────────────────────────────────────────────────

model LabTestCatalog {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  name           String
  code           String
  category       String?
  price          Float  
  turnaroundTime String?  @map("turnaround_time")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  labRequests LabRequest[]

  @@unique([tenantId, code])
  @@map("lab_test_catalog")
}





model LabRequest {
  id            String           @id @default(uuid())
  tenantId      String           @map("tenant_id")
  visitId       String           @map("visit_id")
  testId        String           @map("test_id")
  requestedById String           @map("requested_by")
  priority      String      @default("normal")
  clinicalInfo  String?          @map("clinical_info")
  status        String @default("requested")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  visit       Visit          @relation(fields: [visitId], references: [id])
  test        LabTestCatalog @relation(fields: [testId], references: [id])
  requestedBy User           @relation("LabRequestedBy", fields: [requestedById], references: [id])
  result      LabResult?

  @@map("lab_requests")
}

model LabResult {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  labRequestId   String   @unique @map("lab_request_id")
  resultValue    String   @map("result_value")
  unit           String?
  referenceRange String?  @map("reference_range")
  isAbnormal     Boolean  @default(false) @map("is_abnormal")
  notes          String?
  performedById  String   @map("performed_by")
  verifiedById   String?  @map("verified_by")
  resultDate     DateTime @map("result_date")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  labRequest  LabRequest @relation(fields: [labRequestId], references: [id])
  performedBy User       @relation("LabPerformedBy", fields: [performedById], references: [id])
  verifiedBy  User?      @relation("LabVerifiedBy", fields: [verifiedById], references: [id])

  @@map("lab_results")
}

// ─── Pharmacy & Inventory ───────────────────────────────────────

model Drug {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  name         String
  brandName    String?  @map("brand_name")
  code         String
  category     String?
  form         String?
  strength     String?
  unit         String?
  unitPrice    Float  @map("unit_price") 
  reorderLevel Int      @default(10) @map("reorder_level")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  stock             DrugStock[]
  prescriptionItems PrescriptionItem[]
  stockAlerts       StockAlert[]
  purchaseOrderItems PurchaseOrderItem[]
  grnItems          GrnItem[]

  @@unique([tenantId, code])
  @@map("drugs")
}

model DrugStock {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  drugId       String    @map("drug_id")
  batchNumber  String    @map("batch_number")
  quantity     Int
  costPrice    Float   @map("cost_price") 
  expiryDate   DateTime  @map("expiry_date") 
  receivedDate DateTime  @map("received_date") 
  grnId        String?   @map("grn_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant          Tenant             @relation(fields: [tenantId], references: [id])
  drug            Drug               @relation(fields: [drugId], references: [id])
  grn             GoodsReceivedNote? @relation(fields: [grnId], references: [id])
  dispensingItems DispensingItem[]

  @@index([tenantId, drugId, expiryDate])
  @@map("drug_stock")
}



model Dispensing {
  id             String           @id @default(uuid())
  tenantId       String           @map("tenant_id")
  prescriptionId String           @map("prescription_id")
  visitId        String           @map("visit_id")
  dispensedById  String           @map("dispensed_by")
  status         String @default("pending")
  notes          String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  prescription Prescription     @relation(fields: [prescriptionId], references: [id])
  visit        Visit            @relation(fields: [visitId], references: [id])
  dispensedBy  User             @relation(fields: [dispensedById], references: [id])
  items        DispensingItem[]

  @@map("dispensing")
}

model DispensingItem {
  id                 String   @id @default(uuid())
  dispensingId       String   @map("dispensing_id")
  prescriptionItemId String   @map("prescription_item_id")
  drugStockId        String   @map("drug_stock_id")
  quantity           Int
  createdAt          DateTime @default(now()) @map("created_at")

  dispensing       Dispensing       @relation(fields: [dispensingId], references: [id], onDelete: Cascade)
  prescriptionItem PrescriptionItem @relation(fields: [prescriptionItemId], references: [id])
  drugStock        DrugStock        @relation(fields: [drugStockId], references: [id])

  @@map("dispensing_items")
}

// ─── Billing & Payments ─────────────────────────────────────────



model Invoice {
  id            String        @id @default(uuid())
  tenantId      String        @map("tenant_id")
  visitId       String        @map("visit_id")
  patientId     String        @map("patient_id")
  invoiceNo     String        @map("invoice_no")
  subtotal      Float       
  taxAmount     Float       @default(0) @map("tax_amount") 
  discount      Float       @default(0) 
  totalAmount   Float       @map("total_amount") 
  paidAmount    Float       @default(0) @map("paid_amount") 
  balance       Float       
  status        String @default("draft")
  dueDate       DateTime?     @map("due_date") 
  generatedById String        @map("generated_by")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  visit       Visit         @relation(fields: [visitId], references: [id])
  patient     Patient       @relation(fields: [patientId], references: [id])
  generatedBy User          @relation(fields: [generatedById], references: [id])
  items       InvoiceItem[]
  payments    Payment[]

  @@unique([tenantId, invoiceNo])
  @@map("invoices")
}



model InvoiceItem {
  id          String          @id @default(uuid())
  invoiceId   String          @map("invoice_id")
  itemType    String @map("item_type")
  referenceId String?         @map("reference_id")
  description String
  quantity    Int
  unitPrice   Float         @map("unit_price") 
  totalPrice  Float         @map("total_price") 
  createdAt   DateTime        @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}



model Payment {
  id            String        @id @default(uuid())
  tenantId      String        @map("tenant_id")
  invoiceId     String        @map("invoice_id")
  paymentMethod String @map("payment_method")
  amount        Float       
  referenceNo   String?       @map("reference_no")
  paymentDate   DateTime      @map("payment_date")
  receivedById  String        @map("received_by")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  invoice          Invoice           @relation(fields: [invoiceId], references: [id])
  receivedBy       User              @relation(fields: [receivedById], references: [id])
  mpesaTransaction MpesaTransaction?

  @@map("payments")
}



model MpesaTransaction {
  id                 String      @id @default(uuid())
  tenantId           String      @map("tenant_id")
  paymentId          String?     @unique @map("payment_id")
  merchantRequestId  String      @map("merchant_request_id")
  checkoutRequestId  String      @map("checkout_request_id")
  phoneNumber        String      @map("phone_number")
  amount             Float     
  mpesaReceipt       String?     @map("mpesa_receipt")
  resultCode         Int?        @map("result_code")
  resultDesc         String?     @map("result_desc")
  status             String @default("initiated")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([checkoutRequestId])
  @@map("mpesa_transactions")
}

// ─── Procurement ────────────────────────────────────────────────

model Supplier {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  name          String
  contactPerson String?  @map("contact_person")
  email         String?
  phone         String?
  address       String?
  taxPin        String?  @map("tax_pin")
  paymentTerms  String?  @map("payment_terms")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  purchaseOrders     PurchaseOrder[]
  goodsReceivedNotes GoodsReceivedNote[]

  @@unique([tenantId, name])
  @@map("suppliers")
}



model PurchaseOrder {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  poNumber      String   @map("po_number")
  supplierId    String   @map("supplier_id")
  status        String @default("draft")
  totalAmount   Float  @map("total_amount") 
  notes         String?
  requestedById String   @map("requested_by")
  approvedById  String?  @map("approved_by")
  orderDate     DateTime @map("order_date") 
  expectedDate  DateTime? @map("expected_date") 
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  supplier           Supplier            @relation(fields: [supplierId], references: [id])
  requestedBy        User                @relation("PORequestedBy", fields: [requestedById], references: [id])
  approvedBy         User?               @relation("POApprovedBy", fields: [approvedById], references: [id])
  items              PurchaseOrderItem[]
  goodsReceivedNotes GoodsReceivedNote[]

  @@unique([tenantId, poNumber])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String   @id @default(uuid())
  purchaseOrderId String   @map("purchase_order_id")
  drugId          String   @map("drug_id")
  quantity        Int
  unitCost        Float  @map("unit_cost") 
  totalCost       Float  @map("total_cost") 
  receivedQty     Int      @default(0) @map("received_qty")
  createdAt       DateTime @default(now()) @map("created_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  drug          Drug          @relation(fields: [drugId], references: [id])
  grnItems      GrnItem[]

  @@map("purchase_order_items")
}

model GoodsReceivedNote {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  grnNumber       String   @map("grn_number")
  purchaseOrderId String   @map("purchase_order_id")
  supplierId      String   @map("supplier_id")
  receivedById    String   @map("received_by")
  receivedDate    DateTime @map("received_date") 
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  purchaseOrder PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id])
  supplier      Supplier          @relation(fields: [supplierId], references: [id])
  receivedBy    User              @relation(fields: [receivedById], references: [id])
  items         GrnItem[]
  drugStock     DrugStock[]

  @@unique([tenantId, grnNumber])
  @@map("goods_received_notes")
}

model GrnItem {
  id         String   @id @default(uuid())
  grnId      String   @map("grn_id")
  poItemId   String   @map("po_item_id")
  drugId     String   @map("drug_id")
  quantity   Int
  batchNumber String  @map("batch_number")
  expiryDate DateTime @map("expiry_date") 
  costPrice  Float  @map("cost_price") 
  createdAt  DateTime @default(now()) @map("created_at")

  grn    GoodsReceivedNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
  poItem PurchaseOrderItem @relation(fields: [poItemId], references: [id])
  drug   Drug              @relation(fields: [drugId], references: [id])

  @@map("grn_items")
}



model StockAlert {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  drugId       String    @map("drug_id")
  alertType    String @map("alert_type")
  currentStock Int       @map("current_stock")
  reorderLevel Int       @map("reorder_level")
  isResolved   Boolean   @default(false) @map("is_resolved")
  resolvedAt   DateTime? @map("resolved_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  drug   Drug   @relation(fields: [drugId], references: [id])

  @@index([tenantId, isResolved])
  @@map("stock_alerts")
}

// ─── Accounts ───────────────────────────────────────────────────

model ExpenseCategory {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  expenses Expense[]

  @@unique([tenantId, name])
  @@map("expense_categories")
}





model Expense {
  id            String               @id @default(uuid())
  tenantId      String               @map("tenant_id")
  categoryId    String               @map("category_id")
  amount        Float              
  description   String
  referenceNo   String?              @map("reference_no")
  expenseDate   DateTime             @map("expense_date") 
  paymentMethod String @map("payment_method")
  receiptUrl    String?              @map("receipt_url")
  recordedById  String               @map("recorded_by")
  approvedById  String?              @map("approved_by")
  status        String        @default("pending")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  category   ExpenseCategory @relation(fields: [categoryId], references: [id])
  recordedBy User            @relation("ExpenseRecordedBy", fields: [recordedById], references: [id])
  approvedBy User?           @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])

  @@index([tenantId, expenseDate])
  @@map("expenses")
}



model LedgerEntry {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  entryDate     DateTime  @map("entry_date") 
  entryType     String @map("entry_type")
  category      String
  description   String
  debit         Float   @default(0) 
  credit        Float   @default(0) 
  balance       Float   
  referenceType String?   @map("reference_type")
  referenceId   String?   @map("reference_id")
  recordedById  String    @map("recorded_by")
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  recordedBy User   @relation(fields: [recordedById], references: [id])

  @@index([tenantId, entryDate, entryType])
  @@map("ledger_entries")
}

// ─── Audit & Notifications ─────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  userId     String   @map("user_id")
  action     String
  module     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldValues  String?    @map("old_values")
  newValues  String?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, module, createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String?  @map("user_id")
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false) @map("is_read")
  metadata  String?
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, userId, isRead])
  @@map("notifications")
}


